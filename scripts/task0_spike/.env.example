# Copy this file to .env and fill in ONE of the two auth methods below.
# This script only reads market data - it never places or modifies orders.

# --- OAuth2 (recommended for anything long-lived) ---
# Set up a personal OAuth2 app at https://developer.tastytrade.com/oauth2/
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=

# --- Username/password (simpler to get started with, fine for this one-off spike) ---
# TASTYTRADE_USERNAME=
# TASTYTRADE_PASSWORD=
