# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- Postgres / TimescaleDB ---
POSTGRES_DB=options_data
POSTGRES_USER=options_user
POSTGRES_PASSWORD=changeme

# Host-side port TimescaleDB is exposed on (i.e. what you'd connect to from
# a tool on your own machine, like `psql -h localhost -p $HOST_DB_PORT`).
# Change this if 5432 is already taken by a local Postgres install.
HOST_DB_PORT=5432

# NOTE: DATABASE_URL is NOT set here on purpose. docker-compose.yml derives
# it automatically from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above,
# so the password only ever needs to be set in one place. If you're running
# the app directly on your host machine (not via docker compose) — e.g. for
# the "migrations without the full stack" workflow in the README — export
# DATABASE_URL yourself at that point instead of adding it here.

# --- TastyTrade OAuth2 ---
# Username/password auth was discontinued by TastyTrade Dec 1 2025 — this is
# the only supported method now. See task0_spike/README.md for how to
# obtain these (client_id isn't needed at runtime, only during that
# one-time setup).
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_USE_SANDBOX=false

# --- Black-Scholes calculator (Task 6) ---
# Doesn't need to be precise for backtesting purposes — a reasonable
# current short-term rate. Optional; defaults to 0.045 if unset.
RISK_FREE_RATE=0.045

# --- Query API (Task 8) ---
# Optional. Leave unset for a private-network deployment with no auth.
# If set, every request needs a matching X-API-Key header.
API_KEY=

# --- Logging ---
# Level for this app's own code (service/*). Third-party dependencies
# (notably the `tastytrade` package — see service/logging_config.py for
# why) are always clamped to WARNING regardless of this setting, so
# setting DEBUG here won't reintroduce their log volume. Optional;
# defaults to INFO.
LOG_LEVEL=INFO

# --- Contract refresh scheduling (Task 9) ---
# How often the ingestion pipeline re-resolves each ticker's contract set.
# Defaults (300s normal / 30s during 09:25-10:00 ET on weekdays) are
# reasonable starting points; all four are optional and only need setting
# if you want to override them. See service/config/settings.py for full
# rationale.
CONTRACT_REFRESH_INTERVAL_S=300
CONTRACT_REFRESH_FAST_INTERVAL_S=30
CONTRACT_REFRESH_FAST_WINDOW_START=09:25
CONTRACT_REFRESH_FAST_WINDOW_END=10:00

# --- After-hours maintenance scheduler ---
# Runs the daily candle `backfill` (+ Greeks) on a fixed weekday schedule so
# it never has to be run by hand. This is a hard dependency, not a nicety:
# TastyTrade publishes live quotes for SPX but NOT for NDX or VIX, so for
# those two tickers the candle-API backfill is their ONLY data source. See
# PLAN.md Section 7. Start it with the normal stack — `docker compose up -d`
# (not a profile service) — and watch it via `docker compose logs -f scheduler`.
# All five are optional; the defaults below are fine for most setups.
SCHEDULER_ENABLED=true
# HH:MM, America/New_York, weekdays only. Must be after the 16:00 close; the
# 16:30 default adds a 30-minute buffer for the last regular-hours bars to
# settle. DST is handled automatically (a UTC-based schedule would drift an
# hour twice a year).
SCHEDULER_RUN_TIME=16:30
# Also run one job at container startup, not just on schedule. Recommended:
# it catches up any slot missed while the container/host was down, so a
# trading day can't be silently skipped. Nearly free, since `backfill` is
# incremental by default. Set false to strictly wait for the next slot.
SCHEDULER_RUN_ON_STARTUP=true
# Run the Greeks pass after the candles. Keep this on: the backfill writes
# option bars but never writes Greeks, so with this off every
# daily-backfilled option bar lands with NULL Greeks — silently wrong for
# any Greeks-dependent backtest.
SCHEDULER_RUN_GREEKS=true
# Also run the full underlying-gap rescan each day. This is the only
# *scheduled* path that scans for intraday holes rather than just appending
# newer bars, so it's what repairs a morning session lost when
# `underlying-live` restarts mid-day (the proportional backfill is incremental
# and never revisits a hole; see service/ingestion/live_underlying.py). It
# re-scans the whole lookback window, so it's slower than the plain backfill -
# set false only if that cost isn't worth it for you.
SCHEDULER_RUN_GAP_RECONCILE=true

# --- Signal notifications (strategy-monitor, strategy-monitor-0dte) ---
# All optional; with none set the monitors run in log-only mode. Set any
# combination and every entry signal is pushed to each configured channel.
#
# ntfy.sh: subscribe to the EXACT topic in the ntfy app or at
# https://ntfy.sh/<topic>. Anyone who knows a topic can read it, so treat
# each as a shared secret.
NTFY_TOPIC=
# Per-ticker override for the shared topic above, named NTFY_TOPIC_<TICKER>
# (e.g. NTFY_TOPIC_NDX). Use the same naming convention with the ticker
# substituted -- spx-short-term-bull-signals -> ndx-short-term-bull-signals --
# so NDX and SPX land in separate topics. A ticker with no override falls
# back to NTFY_TOPIC.
NTFY_TOPIC_NDX=
# Telegram bot push (send a message to your bot, then take the chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pushover app push.
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# --- 0DTE entry monitor (strategy-monitor-0dte) ---
# Min gap, per config, between posted signals. The monitor replays the four
# approved 0DTE strategies' own entry rule; unlike a once-a-day alert it posts
# each new fillable entry, but no more often than this. A signal inside the
# cooldown is skipped (never queued). 30m default => at most every other 15m
# signal bucket. Alert bodies show Mountain-time stamps and legs nearest the
# money first; ntfy is delivered as Markdown (bullets + real line breaks).
MONITOR_RESIGNAL_MINUTES=30
